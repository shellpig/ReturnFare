            "first_seen_pages": [
              {
                "id": "proxy_ajie_long",
                "text": "很多年後的一張照片裡，阿婕還在鎮上。那雙手握著帳本，指甲修整得乾乾淨淨，早就不咬了。\n走出旅館的那個人，四十歲出頭得了癌症，沒拖多久就走了。",
                "narrative_beats": [
                  "proxy_reminisce",
                  "switch_subject_to_protagonist",
                  "died_early_forties",
                  "died_of_cancer",
                  "died_rapidly"
                ]
              }
            ],
            "repeat_pages": [
              {
                "id": "proxy_ajie_short",
                "text": "多年後的照片中阿婕仍在鎮上。走出山泉閣的人在四十出頭病逝。",
                "narrative_beats": [
                  "proxy_reminisce",
                  "protagonist_dies_early_forties"
                ]
              }
            ]
          },
          {
            "value": "awei",
            "first_seen_pages": [
              {
                "id": "proxy_awei_long",
                "text": "後來偶爾能看見阿薇在靜和園的身影。她和客人說話時大大方方地笑著，不再習慣性地抬手掩嘴。\n至於那個從山泉閣出門的人，剛滿四十歲就被癌症帶走，從確診到闔眼只花了幾週。",
                "narrative_beats": [
                  "proxy_reminisce",
                  "switch_subject_to_protagonist",
                  "died_early_forties",
                  "died_of_cancer",
                  "died_rapidly"
                ]
              }
            ],
            "repeat_pages": [
              {
                "id": "proxy_awei_short",
                "text": "多年後阿薇在靜和園如常生活。走出山泉閣的人四十出頭因病離世。",
                "narrative_beats": [
                  "proxy_reminisce",
                  "protagonist_dies_early_forties"
                ]
              }
            ]
          },
          {
            "value": "acai",
            "first_seen_pages": [
              {
                "id": "proxy_acai_long",
                "text": "鎮上的街坊在雜貨店前碰見阿財，他扛著沉重的貨箱大步走過，腳步平穩，一點也不跛。\n那個走出山泉閣的人，也是在四十歲出頭時被急性癌症奪去性命，走得匆忙。",
                "narrative_beats": [
                  "proxy_reminisce",
                  "switch_subject_to_protagonist",
                  "died_early_forties",
                  "died_of_cancer",
                  "died_rapidly"
                ]
              }
            ],
            "repeat_pages": [
              {
                "id": "proxy_acai_short",
                "text": "多年後阿財在街頭步履如常。走出山泉閣的人在四十出頭病逝。",
                "narrative_beats": [
                  "proxy_reminisce",
                  "protagonist_dies_early_forties"
                ]
              }
            ]
          }
        ]
