    "first_seen": {
      "prefix_pages": [
        {
          "id": "replacement",
          "text": "蒸氣散去。你穿上外套，走出了山泉閣。"
        }
      ],
      "suffix_pages": [
        {
          "id": "years_passed",
          "text": "二十年。日子就這樣一天天過去，錢不再是問題。"
        },
        {
          "id": "long_return",
          "text": "四十出頭。癌症，走得很快。然後是黑。\n庇佑再次發動。你猛然睜開眼睛——"
        }
      ]
    },
    "repeat": {
      "prefix_pages": [
        {
          "id": "again_replaced",
          "text": "替換再次發生。另一個你走出了山泉閣，過完了那段被安排好的人生。"
        }
      ],
      "suffix_pages": [
        {
          "id": "short_return",
          "text": "生命走到終點。庇佑將你再次送回起點。"
        }
      ],
      "skip_to": "short_return"
    },
