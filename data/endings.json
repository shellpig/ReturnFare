            },
            "first_seen_pages": [
              {
                "id": "partner_ajie_long",
                "text": "他最終與阿婕結為連理，在小鎮裡平淡相守，膝下始終未有子嗣。\n二十年光陰彈指而過。行至四十出頭的年歲，阿婕先一步病倒。是急性癌症，惡化得極快，短短數月便在病榻上悄然離世。\n不久之後是他。患上了同一個病症，走得同樣急促迅猛。",
                "narrative_beats": [
                  "marriage",
                  "no_children",
                  "twenty_years",
                  "died_early_forties",
                  "spouse_dies_first",
                  "died_of_cancer",
                  "died_rapidly",
                  "protagonist_same_illness"
                ]
              }
            ],
            "repeat_pages": [
              {
                "id": "partner_ajie_short",
                "text": "他與阿婕成婚，膝下無子。二十年後阿婕先因病離世，隨後他也罹患同種重疾而終。",
                "narrative_beats": [
                  "marriage",
                  "spouse_dies_first",
                  "protagonist_same_illness"
                ]
              }
            ]
          },
          {
            "id": "awei",
            "when": {
              "flag": "invited_awei"
            },
            "first_seen_pages": [
              {
                "id": "partner_awei_long",
                "text": "他最終與阿薇結為夫妻，在青山溫泉間長相廝守，一生沒有要孩子。\n二十年的歲月悄然而逝。剛過四十歲的門檻，阿薇便先一步倒下。癌症來勢洶洶，走得無比迅捷。\n隨後便是他自己。染上了同一種絕症，離開得同樣倉促。",
                "narrative_beats": [
                  "marriage",
                  "no_children",
                  "twenty_years",
                  "died_early_forties",
                  "spouse_dies_first",
                  "died_of_cancer",
                  "died_rapidly",
                  "protagonist_same_illness"
                ]
              }
            ],
            "repeat_pages": [
              {
                "id": "partner_awei_short",
                "text": "他與阿薇結髮為伴，膝下無子。二十年後阿薇先因疾撒手人寰，隨後他亦染同病相隨而去。",
                "narrative_beats": [
                  "marriage",
                  "spouse_dies_first",
                  "protagonist_same_illness"
                ]
              }
            ]
          },
          {
            "id": "none",
            "fallback": true,
            "first_seen_pages": [
              {
                "id": "partner_none_long",
                "text": "他一生未曾娶妻成家，隻身一人孤獨而平靜地走過了二十年的光陰。",
                "narrative_beats": [
                  "no_marriage",
                  "single_twenty_years"
                ]
              }
            ],
            "repeat_pages": [
              {
                "id": "partner_none_short",
                "text": "他終生未娶，獨自一人在小鎮度過了二十個春秋。",
                "narrative_beats": [
                  "no_marriage",
                  "single_twenty_years"
                ]
              }
            ]
          }
