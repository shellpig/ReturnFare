    "first_seen": {
      "prefix_pages": [
        {
          "id": "replacement",
          "text": "滾燙的硫磺蒸氣悄然散盡。穿著整潔外套的『你』平靜地推開木門，邁著沉穩而陌生的步伐，走出了山泉閣的大廳。",
          "narrative_beats": [
            "observable_exit_sanquan"
          ]
        }
      ],
      "suffix_pages": [
        {
          "id": "long_return",
          "text": "視線陷入了無邊無際的深黑。\n深埋在靈魂深處的古老庇佑在死寂中轟然再度發動。在劇烈的震顫與心悸中，你猛然睜開了眼睛——",
          "narrative_beats": [
            "black_screen",
            "blessing_reactivated"
          ]
        }
      ]
    },
    "repeat": {
      "prefix_pages": [
        {
          "id": "again_replaced",
          "text": "替換的儀軌再次無聲降臨。另一個完美無瑕的『你』推門走出了山泉閣，在小鎮溫柔的謊言中，替你過完了那段被命運精密安排好的一生。"
        }
      ],
      "suffix_pages": [
        {
          "id": "short_return",
          "text": "四十餘載的浮生如白駒過隙走到終點。沈默的古老庇佑，將你的意識再次無情地拽回了最初的起點。"
        }
      ],
      "skip_to": "short_return"
    },
