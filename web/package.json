{
  "name": "returnfare-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "lint:data": "tsx scripts/lint-data.ts",
    "dev": "node scripts/sync-data.mjs && npm run lint:data && vite",
    "build": "node scripts/sync-data.mjs && npm run lint:data && tsc --noEmit && vite build",
    "test": "vitest run",
    "fonts:collect": "tsx scripts/collect-font-text.ts",
    "fonts:subset": "npm run fonts:collect && ..\\.venv\\Scripts\\python.exe ..\\tools\\fonts\\subset_fonts.py",
    "trace:web": "tsx scripts/trace-web.ts",
    "trace:compare": "tsx ../tools/trace/cli.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
